{
  "name": "allan-dave-ebale-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static portfolio generated from reusable React and Tailwind components.",
  "scripts": {
    "build": "npm run build:css && npm run build:pages",
    "build:css": "tailwindcss -i ./src/portfolio.css -o ./portfolio.css --minify",
    "build:pages": "tsx ./scripts/render-portfolio.jsx",
    "serve": "python3 -m http.server 8000 --bind 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6"
  }
}
